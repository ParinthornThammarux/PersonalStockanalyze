{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Streamlit app",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": ["run", "app/streamlit_app.py"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "CLI: status",
            "type": "debugpy",
            "request": "launch",
            "module": "stockanalyzer",
            "args": ["status"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
